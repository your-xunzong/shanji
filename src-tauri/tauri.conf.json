{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "闪记",
  "version": "0.13.1",
  "identifier": "com.shanji.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "label": "main",
        "title": "闪记",
        "url": "index.html",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "visible": true,
        "backgroundColor": "#E9EDF2"
      },
      {
        "create": false,
        "label": "capture",
        "title": "快速记录 · 闪记",
        "url": "index.html?view=capture",
        "width": 660,
        "height": 316,
        "minWidth": 520,
        "minHeight": 300,
        "center": true,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": true,
        "skipTaskbar": true,
        "backgroundColor": "#F9FAFB",
        "shadow": true
      },
      {
        "create": false,
        "label": "reminder",
        "title": "提醒 · 闪记",
        "url": "index.html?view=reminder",
        "width": 390,
        "height": 230,
        "minWidth": 350,
        "minHeight": 210,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "backgroundColor": "#F9FAFB",
        "shadow": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "useLocalToolsDir": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "快速记录，按时回来",
    "longDescription": "离线优先的跨平台快速备忘与提醒工具",
    "copyright": "© 2026 闪记",
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "customLanguageFiles": {
          "SimpChinese": "nsis/languages/SimpChinese.nsh"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaW5pIHB1YmxpYyBrZXk6IEJGOTQzNUMxOUEwMDkwNzcKUldSM2tBQ2F3VFdVdi9wU3VUT01IaE80bVpHbEtZYzI3NVQ5eTl6MzhuaEVtM3ZrcWNCSHA3YVEK",
      "endpoints": [
        "https://github.com/your-xunzong/shanji/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
